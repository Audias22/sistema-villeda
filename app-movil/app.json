{
  "expo": {
    "name": "Oficina Villeda",
    "slug": "oficina-villeda",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.villeda.oficinavilleda",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-local-authentication",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Oficina Villeda usa la cámara para escanear documentos del expediente.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F5F2"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e50068cc-c4ef-4b33-883b-d1390f82c766"
      }
    },
    "owner": "audias22"
  }
}
